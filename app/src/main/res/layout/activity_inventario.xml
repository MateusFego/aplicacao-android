<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTituloInv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inventário de IPs"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editNomeAtivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome (ex: Proxmox L14)"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloInv" />

    <EditText
        android:id="@+id/editIpAtivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Endereço IP"
        app:layout_constraintTop_toBottomOf="@id/editNomeAtivo" />
    <EditText
        android:id="@+id/editBuscaAtivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pesquisar por nome ou IP..."
        app:layout_constraintTop_toBottomOf="@id/btSalvarAtivo" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAtivos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/editBuscaAtivo"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/btSalvarAtivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar no Firestore"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/editIpAtivo" />

</androidx.constraintlayout.widget.ConstraintLayout>