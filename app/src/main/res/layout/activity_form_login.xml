<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background"
        tools:context=".FormLogin">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/logo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo de cadeado"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/txt_nome_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFRA TOOLKIT"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:textColor="@color/black"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/containercomponens"
            style="@style/ContainerComponents"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_nome_app" />

        <EditText
            android:id="@+id/edit_email"
            style="@style/Edit_Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="E-mail"
            android:drawableEnd="@drawable/baseline_email_24"
            app:layout_constraintStart_toStartOf="@+id/containercomponens"
            app:layout_constraintEnd_toEndOf="@+id/containercomponens"
            app:layout_constraintTop_toTopOf="@+id/containercomponens"
            android:layout_marginTop="30dp"/>

        <EditText
            android:id="@+id/edit_senha"
            style="@style/Edit_Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Senha"
            android:drawableEnd="@drawable/outline_album_24"
            app:layout_constraintStart_toStartOf="@+id/containercomponens"
            app:layout_constraintEnd_toEndOf="@+id/containercomponens"
            app:layout_constraintTop_toBottomOf="@+id/edit_email"
            android:layout_marginTop="15dp"
            android:maxLength="25"
            android:inputType="textPassword"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bt_entrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Entrar"
            style="@style/button"
            app:layout_constraintStart_toStartOf="@+id/containercomponens"
            app:layout_constraintEnd_toEndOf="@+id/containercomponens"
            app:layout_constraintTop_toBottomOf="@id/edit_senha"
            android:layout_marginTop="25dp"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bt_entrada"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/text_tela_cadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crie uma conta clicando aqui"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:paddingBottom="20dp"
            app:layout_constraintTop_toBottomOf="@+id/bt_entrada"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>